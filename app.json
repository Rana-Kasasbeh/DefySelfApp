{
  "expo": {
    "name": "DefySelf",
    "slug": "defyself",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.defyself.app",
      "buildNumber": "1.0.0",
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-4514668400858247~1234567890"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.defyself.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-4514668400858247~1234567890"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4514668400858247~1234567890",
          "iosAppId": "ca-app-pub-4514668400858247~1234567890",
          "userTrackingPermission": "يستخدم هذا التطبيق الإعلانات لتوفير محتوى مجاني."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ab6d8f9a-2c6f-4f48-a7f7-f11f9286a94f"
      }
    }
  }
}