// @route   POST /api/vocabulary/words
// @desc    إضافة كلمة جديدة (للمشرف)
// @access  Private
router.post('/words', auth, async (req, res) => {
  try {
    const { word, translation, category, difficulty, example, pronunciation, partOfSpeech } = req.body;

    // التحقق من البيانات المطلوبة
    if (!word || !translation) {
      return res.status(400).json({
        success: false,
        message: 'الكلمة والترجمة مطلوبة'
      });
    }

    // الحصول على آخر ID
    const lastWord = await Word.findOne().sort({ id: -1 });
    const newId = lastWord ? lastWord.id + 1 : 1;

    const newWord = new Word({
      id: newId,
      word,
      translation,
      category: category || 'general',
      difficulty: difficulty || 'easy',
      example,
      pronunciation,
      partOfSpeech: partOfSpeech || 'noun'
    });

    await newWord.save();

    res.status(201).json({
      success: true,
      message: 'تم إضافة الكلمة بنجاح',
      data: newWord
    });
  } catch (error) {
    console.error('Error adding word:', error);
    res.status(500).json({
      success: false,
      message: 'خطأ في إضافة الكلمة',
      error: error.message
    });
  }
});

module.exports = router;