// @route   GET /api/vocabulary/words/:id
// @desc    الحصول على كلمة واحدة
// @access  Private
router.get('/words/:id', auth, async (req, res) => {
  try {
    const word = await Word.findOne({ id: parseInt(req.params.id) });

    if (!word) {
      return res.status(404).json({
        success: false,
        message: 'الكلمة غير موجودة'
      });
    }

    res.json({
      success: true,
      data: word
    });
  } catch (error) {
    console.error('Error fetching word:', error);
    res.status(500).json({
      success: false,
      message: 'خطأ في جلب الكلمة',
      error: error.message
    });
  }
});

