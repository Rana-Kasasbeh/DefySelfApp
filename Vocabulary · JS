const express = require('express');
const router = express.Router();
const Word = require('../models/Word');
const auth = require('../middleware/auth');

// @route   GET /api/vocabulary/words
// @desc    الحصول على جميع الكلمات مع إمكانية الفلترة
// @access  Private
router.get('/words', auth, async (req, res) => {
  try {
    const { 
      category, 
      difficulty, 
      learned, 
      limit = 20, 
      page = 1,
      search 
    } = req.query;

    // بناء الاستعلام
    const query = {};
    
    if (category) query.category = category;
    if (difficulty) query.difficulty = difficulty;
    if (learned !== undefined) query.learned = learned === 'true';
    if (search) {
      query.$or = [
        { word: { $regex: search, $options: 'i' } },
        { translation: { $regex: search, $options: 'i' } }
      ];
    }

    // الحصول على الكلمات مع pagination
    const skip = (parseInt(page) - 1) * parseInt(limit);
    const words = await Word.find(query)
      .limit(parseInt(limit))
      .skip(skip)
      .sort({ id: 1 });

    const total = await Word.countDocuments(query);

    res.json({
      success: true,
      data: words,
      pagination: {
        total,
        page: parseInt(page),
        pages: Math.ceil(total / parseInt(limit)),
        limit: parseInt(limit)
      }
    });
  } catch (error) {
    console.error('Error fetching words:', error);
    res.status(500).json({
      success: false,
      message: 'خطأ في جلب الكلمات',
      error: error.message
    });
  }
});

