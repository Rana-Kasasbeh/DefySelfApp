import AsyncStorage from '@react-native-async-storage/async-storage';

// ==================== STORAGE KEYS ====================
export const STORAGE_KEYS = {
  // User Data
  USER_DATA: '@user_data',
  USER_PROGRESS: '@user_progress',
  USER_TOKEN: '@user_token',
  IS_LOGGED_IN: '@is_logged_in',
  
  // Theme & Language
  THEME: '@app_theme',
  LANGUAGE: '@app_language',
  
  // Time Tracking
  TIME_WATER: '@time_spent_water',

  TIME_HABITS: '@time_spent_habits',
  TIME_LANGUAGE: '@time_spent_language',
  
  // Feature-specific Data
  WATER_DATA: '@water_tracker_data',

  HABITS_DATA: '@habits_tracker_data',
  LANGUAGE_DATA: '@language_learning_data',
  
  // Backup
  BACKUP_PREFIX: '@backup_',
  BACKUP_CODE_PREFIX: '@backup_code_',
} as const;

// ==================== TYPES ====================
export interface WaterData {
  dailyGoal: number;
  consumed: number;
  history: Array<{
    date: string;
    amount: number;
    goal: number;
  }>;
  streak: number;
  lastUpdate: string;
}

export interface HabitsData {
  habits: Array<{
    id: string;
    name: string;
    completed: boolean;
    streak: number;
    history: string[];
  }>;
  totalHabits: number;
  completedToday: number;
  lastUpdate: string;
}

export interface LanguageData {
  wordsLearned: number;
  currentLesson: number;
  quizzesPassed: number;
  vocabulary: Array<{
    word: string;
    translation: string;
    learned: boolean;
    reviewCount: number;
  }>;
  lastStudyDate: string;
}

// ==================== DATA MANAGER CLASS ====================
class DataManager {
  // ==================== GENERIC METHODS ====================
  
  /**
   * حفظ بيانات بشكل عام
   */
  async saveData<T>(key: string, data: T): Promise<void> {
    try {
      const jsonData = JSON.stringify(data);
      await AsyncStorage.setItem(key, jsonData);
      console.log(`✅ Data saved: ${key}`);
    } catch (error) {
      console.error(`❌ Error saving data for ${key}:`, error);
      throw error;
    }
  }

  /**
   * تحميل بيانات بشكل عام
   */
  async loadData<T>(key: string, defaultValue: T): Promise<T> {
    try {
      const data = await AsyncStorage.getItem(key);
      if (data !== null) {
        const parsedData = JSON.parse(data);
        console.log(`✅ Data loaded: ${key}`);
        return parsedData;
      }
      console.log(`ℹ️ No data found for ${key}, using default`);
      return defaultValue;
    } catch (error) {
      console.error(`❌ Error loading data for ${key}:`, error);
      return defaultValue;
    }
  }

  /**
   * حذف بيانات
   */
  async removeData(key: string): Promise<void> {
    try {
      await AsyncStorage.removeItem(key);
      console.log(`✅ Data removed: ${key}`);
    } catch (error) {
      console.error(`❌ Error removing data for ${key}:`, error);
      throw error;
    }
  }

  // ==================== USER-SPECIFIC DATA ====================
  
  /**
   * حفظ بيانات مرتبطة بمستخدم معين
   */
  async saveUserData<T>(uid: string, key: string, data: T): Promise<void> {
    const userKey = `${key}_${uid}`;
    await this.saveData(userKey, data);
  }

  /**
   * تحميل بيانات مرتبطة بمستخدم معين
   */
  async loadUserData<T>(uid: string, key: string, defaultValue: T): Promise<T> {
    const userKey = `${key}_${uid}`;
    return await this.loadData(userKey, defaultValue);
  }

  /**
   * حذف جميع بيانات مستخدم معين
   */
  async clearUserData(uid: string): Promise<void> {
    try {
      const allKeys = await AsyncStorage.getAllKeys();
      const userKeys = allKeys.filter(key => key.endsWith(`_${uid}`));
      
      if (userKeys.length > 0) {
        await AsyncStorage.multiRemove(userKeys);
        console.log(`✅ All user data cleared for uid: ${uid}`);
      }
    } catch (error) {
      console.error('❌ Error clearing user data:', error);
      throw error;
    }
  }

  // ==================== WATER TRACKER ====================
  
  async saveWaterData(uid: string, data: WaterData): Promise<void> {
    await this.saveUserData(uid, STORAGE_KEYS.WATER_DATA, data);
  }

  async loadWaterData(uid: string): Promise<WaterData> {
    const defaultData: WaterData = {
      dailyGoal: 2000,
      consumed: 0,
      history: [],
      streak: 0,
      lastUpdate: new Date().toISOString(),
    };
    return await this.loadUserData(uid, STORAGE_KEYS.WATER_DATA, defaultData);
  }

  // ==================== LANGUAGE ====================
  
  async saveLanguageData(uid: string, data: LanguageData): Promise<void> {
    await this.saveUserData(uid, STORAGE_KEYS.LANGUAGE_DATA, data);
  }

  async loadLanguageData(uid: string): Promise<LanguageData> {
    const defaultData: LanguageData = {
      wordsLearned: 0,
      currentLesson: 1,
      quizzesPassed: 0,
      vocabulary: [],
      lastStudyDate: new Date().toISOString(),
    };
    return await this.loadUserData(uid, STORAGE_KEYS.LANGUAGE_DATA, defaultData);
  }

  // ==================== TIME TRACKING ====================
  
  async saveTimeSpent(screen: 'water' | 'habits' | 'language', seconds: number): Promise<void> {
    const keyMap = {
      water: STORAGE_KEYS.TIME_WATER,
     
      habits: STORAGE_KEYS.TIME_HABITS,
      language: STORAGE_KEYS.TIME_LANGUAGE,
    };
    
    const key = keyMap[screen];
    const existingTime = await this.loadData(key, 0);
    const totalTime = existingTime + seconds;
    
    await this.saveData(key, totalTime);
  }

  async getTimeSpent(screen: 'water' | 'habits' | 'language'): Promise<number> {
    const keyMap = {
      water: STORAGE_KEYS.TIME_WATER,

      habits: STORAGE_KEYS.TIME_HABITS,
      language: STORAGE_KEYS.TIME_LANGUAGE,
    };
    
    return await this.loadData(keyMap[screen], 0);
  }

  async getAllTimeSpent(): Promise<{ water: number; habits: number; language: number }> {
    const [water, habits, language] = await Promise.all([
      this.getTimeSpent('water'),
   
      this.getTimeSpent('habits'),
      this.getTimeSpent('language'),
    ]);

    return { water, habits, language };
  }

  // ==================== BACKUP & RESTORE ====================
  
  async createBackup(): Promise<string> {
    try {
      const allKeys = await AsyncStorage.getAllKeys();
      const allData = await AsyncStorage.multiGet(allKeys);
      const backupData = Object.fromEntries(allData);
      
      const backupString = JSON.stringify(backupData);
      const timestamp = new Date().getTime();
      const code = `DS${timestamp.toString().slice(-8)}`;
      
      // حفظ النسخة الاحتياطية
      await AsyncStorage.setItem(`${STORAGE_KEYS.BACKUP_PREFIX}${timestamp}`, backupString);
      await AsyncStorage.setItem(`${STORAGE_KEYS.BACKUP_CODE_PREFIX}${code}`, backupString);
      
      console.log('✅ Backup created with code:', code);
      return code;
    } catch (error) {
      console.error('❌ Error creating backup:', error);
      throw error;
    }
  }

  async restoreBackup(code: string): Promise<boolean> {
    try {
      const backupData = await AsyncStorage.getItem(`${STORAGE_KEYS.BACKUP_CODE_PREFIX}${code}`);
      
      if (!backupData) {
        console.error('❌ Backup not found for code:', code);
        return false;
      }

      const parsedData = JSON.parse(backupData);
      const entries = Object.entries(parsedData);

      // استعادة جميع البيانات
      for (const [key, value] of entries) {
        if (value !== null && typeof value === 'string') {
          await AsyncStorage.setItem(key, value);
        }
      }

      console.log('✅ Backup restored successfully');
      return true;
    } catch (error) {
      console.error('❌ Error restoring backup:', error);
      return false;
    }
  }

  // ==================== CLEAR ALL DATA ====================
  
  async clearAllAppData(keepAuth: boolean = true): Promise<void> {
    try {
      const allKeys = await AsyncStorage.getAllKeys();
      
      let keysToRemove = allKeys;
      
      if (keepAuth) {
        // الاحتفاظ ببيانات تسجيل الدخول
        keysToRemove = allKeys.filter(
          key =>
            !key.includes(STORAGE_KEYS.USER_TOKEN) &&
            !key.includes(STORAGE_KEYS.USER_DATA) &&
            !key.includes(STORAGE_KEYS.IS_LOGGED_IN)
        );
      }

      if (keysToRemove.length > 0) {
        await AsyncStorage.multiRemove(keysToRemove);
        console.log(`✅ Cleared ${keysToRemove.length} items from storage`);
      }
    } catch (error) {
      console.error('❌ Error clearing app data:', error);
      throw error;
    }
  }

  // ==================== EXPORT DATA ====================
  
  async exportAllData(): Promise<string> {
    try {
      const allKeys = await AsyncStorage.getAllKeys();
      const allData = await AsyncStorage.multiGet(allKeys);
      const dataObject = Object.fromEntries(allData);
      
      return JSON.stringify(dataObject, null, 2);
    } catch (error) {
      console.error('❌ Error exporting data:', error);
      throw error;
    }
  }

  // ==================== SYNC STATUS ====================
  
  async getStorageInfo(): Promise<{
    totalKeys: number;
    estimatedSize: number;
    keys: string[];
  }> {
    try {
      const allKeys = await AsyncStorage.getAllKeys();
      const allData = await AsyncStorage.multiGet(allKeys);
      
      const estimatedSize = allData.reduce((total, [key, value]) => {
        return total + (value ? value.length : 0);
      }, 0);

      return {
        totalKeys: allKeys.length,
        estimatedSize,
        keys: [...allKeys], // Convert readonly array to mutable array
      };
    } catch (error) {
      console.error('❌ Error getting storage info:', error);
      throw error;
    }
  }
}

// ==================== SINGLETON INSTANCE ====================
const dataManager = new DataManager();

// ==================== EXPORTS ====================
export default dataManager;
export { DataManager };